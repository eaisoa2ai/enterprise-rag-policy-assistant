# Copy to .env and add your key.
#
# Unlike the mock-first providers in outreach-iq, PolicyIQ's core value
# proposition — retrieval quality — can't be meaningfully demoed with a fake
# embedding. OPENAI_API_KEY is required for both embeddings (ingestion) and
# answer generation. Cost is trivial at this corpus size: ingesting the
# ~10 sample documents costs a fraction of a cent in embedding tokens.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

VECTORSTORE_PATH=./vectorstore/index.json

# Observability: leave unset for console-only tracing (zero infra).
# Set to a real OTLP collector endpoint to ship spans elsewhere.
OTEL_EXPORTER_OTLP_ENDPOINT=
